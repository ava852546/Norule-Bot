{
  "name": "javabotopenai-web-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "dev:dashboard": "nuxt dev dashboard --host 127.0.0.1 --port 5173",
    "build": "npm run generate:dashboard && npm run sync:dashboard && npm run generate:short-url && npm run sync:short-url",
    "generate:dashboard": "nuxt generate dashboard",
    "sync:dashboard": "node scripts/sync-dashboard-output.mjs",
    "generate:short-url": "nuxt generate",
    "sync:short-url": "node scripts/sync-static-output.mjs",
    "typecheck": "nuxt typecheck && nuxt typecheck dashboard",
    "test": "vitest run",
    "preview": "npx serve .output/public",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "4.6.4",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@vercel/nft@1.11.1": {
      "glob": {
        ".": "14.0.2",
        "minimatch": "11.0.1"
      }
    },
    "readdir-glob@3.0.0": {
      "minimatch": "11.0.1"
    }
  }
}
